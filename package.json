{
  "name": "pocket-game-night",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --config tests/vitest.config.ts --passWithNoTests",
    "test:browser": "playwright test --config tests/playwright.config.ts",
    "test:mutation": "stryker run tests/stryker.config.mjs",
    "test:mutation:summary": "node tests/mutation/summary.mjs",
    "test:extended": "vitest run --config tests/vitest.extended.config.ts",
    "test:android": "playwright test --config tests/playwright.android.config.ts",
    "build:rhymes": "node scripts/build-rhymes.mjs",
    "build:words": "node scripts/build-words.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
